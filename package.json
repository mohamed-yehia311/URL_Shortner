{
  "name": "url_shortner",
  "version": "1.0.0",
  "description": "A high-performance, low-latency URL shortening and analytics system built for scale. Features instant Redis-backed caching for public redirects, a secure PostgreSQL write path with RBAC authentication, and an asynchronous ClickHouse analytics pipeline for deep telemetry insights.",
  "homepage": "https://github.com/mohamed-yehia311/URL_Shortner#readme",
  "bugs": {
    "url": "https://github.com/mohamed-yehia311/URL_Shortner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamed-yehia311/URL_Shortner.git"
  },
  "author": "Mohamed Yehia",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node ./src/server.ts",
    "start:prod": "node ./dist/src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:sanity": "jest -t \"#sanity\"",
    "test:api": "jest -t \"#api\"",
    "test:unit": "jest -t \"#unit\"",
    "test:security": "jest -t \"#security\"",
    "test:auth": "jest -t \"#AUTH\"",
    "test:urls": "jest -t \"#URL\""
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
