### 1. Register a user (run once; use unique username/email)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "sam",
  "email": "sam@example.com",
  "password": "replace-with-a-long-password"
}

### 2. Log in, then copy access_token and refresh_token from the response above
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "sam@example.com",
  "password": "replace-with-a-long-password"
}

### 3. Create a shortened URL (requires Bearer access token)
POST {{baseUrl}}/urls
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "original_url": "https://example.com/very/long/path"
}

###

### 4. List your URLs (owner comes from the access token)
GET {{baseUrl}}/urls
Authorization: Bearer {{accessToken}}

###

### 5. Resolve / redirect a short key (public endpoint)
GET {{baseUrl}}/urls/replace_with_short_key

###

### 6. Delete your URL (requires Bearer access token)
DELETE {{baseUrl}}/urls/replace_with_short_key
Authorization: Bearer {{accessToken}}

### 7. Refresh token (copy both newly returned tokens; old refresh token is revoked)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### 8. Log out / revoke current refresh token
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}